<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Basil Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Basil Manager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="header-inner">
          <%= link_to "Basil Manager", admin_root_path, class: "brand" %>
          <nav class="primary-nav" aria-label="メインメニュー">
            <%= link_to "株", admin_stocks_path %>
            <%= link_to "植物", admin_plants_path %>
            <%= link_to "場所", admin_locations_path %>
            <%= link_to "作業履歴", admin_stock_action_logs_path %>
            <%= link_to "観察記録", admin_stock_observations_path %>
            <%= link_to "場所の記録", admin_location_observations_path %>
          </nav>
          <%= link_to "CSVを出力", admin_data_export_path, class: "button button-secondary header-export" %>
        </div>
        <nav class="quick-nav" aria-label="よく使う操作">
          <%= link_to "株を作成", new_admin_stock_path %>
          <%= link_to "作業を記録", new_admin_stock_action_log_path %>
          <%= link_to "水やりを一括記録", bulk_new_admin_stock_action_logs_path %>
          <%= link_to "観察を記録", new_admin_stock_observation_path %>
          <%= link_to "場所の記録を追加", new_admin_location_observation_path %>
        </nav>
      </header>

      <main class="app-main">
        <% flash.each do |type, message| %>
          <div class="flash flash--<%= type %>"><%= message %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
