<dl class="summary-grid">
  <% items.each do |item| %>
    <div class="summary-card">
      <dt><%= item[:label] %></dt>
      <dd>
        <strong class="summary-value"><%= item[:value] %></strong>
        <%= item[:unit] %>
      </dd>
      <% if item[:note].present? %>
        <p class="summary-note"><%= item[:note] %></p>
      <% end %>
    </div>
  <% end %>
</dl>
