<div class="page-actions resource-actions" aria-label="植物の操作">
  <% if plant&.persisted? && current_action.in?([:show, :edit]) %>
    <%= render "admin/shared/record_navigation",
               previous_record: previous_record,
               next_record: next_record,
               navigation_action: current_action == :edit ? :edit : nil %>
  <% end %>

  <% if plant&.persisted? %>
    <% if current_action == :show %>
      <span class="button button-secondary" aria-current="page">詳細</span>
    <% else %>
      <%= link_to "詳細", admin_plant_path(plant), class: "button button-secondary" %>
    <% end %>

    <% if current_action == :edit %>
      <span class="button" aria-current="page">編集</span>
    <% else %>
      <%= link_to "編集", edit_admin_plant_path(plant), class: "button" %>
    <% end %>

    <%= form_with model: [:admin, plant], method: :delete, class: "inline-form" do |f| %>
      <%= f.submit "削除", class: "button-danger", data: { turbo_confirm: "本当に削除しますか？" } %>
    <% end %>
  <% end %>

  <% if current_action == :new %>
    <span class="button button-secondary" aria-current="page">植物を追加</span>
  <% else %>
    <%= link_to "植物を追加", new_admin_plant_path, class: "button button-secondary" %>
  <% end %>

  <% if current_action == :index %>
    <span class="button button-secondary" aria-current="page">植物一覧</span>
  <% else %>
    <%= link_to "植物一覧", admin_plants_path, class: "button button-secondary" %>
  <% end %>
</div>
