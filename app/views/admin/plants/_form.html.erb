<%= form_with model: [:admin, plant], class: "form-card" do |f| %>
  <div class="form-field">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, placeholder: "例: バジル" %>
  </div>
  <div class="form-field">
    <%= f.label :code, "コード" %>
    <%= f.text_field :code, placeholder: "例: basil" %>
  </div>
  <div class="form-field">
    <%= f.label :scientific_name, "学名" %>
    <%= f.text_field :scientific_name, placeholder: "例: Ocimum basilicum" %>
  </div>

  <div class="form-field" data-controller="image-preview">
    <%= f.label :image, "画像" %>
    <%= expandable_thumbnail(plant.icon_path, plant.image, alt: "現在の画像") if plant.has_image? %>
    <%= f.file_field :image, data: { action: "change->image-preview#preview" } %>
    <img data-image-preview-target="image" width="100" hidden>
  </div>

  <%= f.submit plant.persisted? ? "更新" : "作成" %>
<% end %>
