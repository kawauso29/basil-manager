<div class="page-header">
  <div>
    <h1 class="page-title"><%= @plant.name %></h1>
    <p class="page-subtitle">植物マスタ</p>
  </div>
  <%= render "actions",
             plant: @plant,
             current_action: :show,
             previous_record: @previous_record,
             next_record: @next_record %>
</div>

<section class="detail-card detail-layout">
  <dl class="detail-list">
    <dt>コード</dt>
    <dd><%= @plant.code %></dd>
    <dt>学名</dt>
    <dd><%= @plant.scientific_name.presence || "—" %></dd>
    <dt>作成日</dt>
    <dd><%= @plant.created_at.strftime("%Y/%m/%d %H:%M") %></dd>
    <dt>更新日</dt>
    <dd><%= @plant.updated_at.strftime("%Y/%m/%d %H:%M") %></dd>
  </dl>
  <%= image_tag(@plant.thumb_path, class: "record-image", alt: @plant.name) if @plant.has_image? %>
</section>

<section class="panel">
  <h2>この植物の生産ロット</h2>
  <% if @production_lots.any? %>
    <div class="page-actions">
      <% @production_lots.each do |production_lot| %>
        <%= link_to "LOT-#{production_lot.id}", admin_production_lot_path(production_lot), class: "button button-secondary" %>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state">生産ロットはまだありません。</p>
  <% end %>
</section>

<section class="panel">
  <h2>この植物の株</h2>
  <% if @stocks.any? %>
    <% @stocks.each do |stock| %>
      <%= render "/admin/stocks/stock_attr", stock: stock %>
    <% end %>
  <% else %>
    <p class="empty-state">株はまだありません。</p>
  <% end %>
</section>
