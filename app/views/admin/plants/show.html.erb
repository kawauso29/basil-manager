<div class="page-header"><div><h1 class="page-title"><%= @plant.name %></h1><p class="page-subtitle">植物マスタ</p></div><div class="page-actions"><%= link_to "編集", edit_admin_plant_path(@plant), class: "button" %><%= link_to "一覧へ戻る", admin_plants_path, class: "button button-secondary" %></div></div>
<section class="detail-card detail-layout">
  <dl class="detail-list"><dt>コード</dt><dd><%= @plant.code %></dd><dt>プレフィックス</dt><dd><%= @plant.prefix %></dd><dt>最終株番号</dt><dd><%= @plant.last_stock_number %></dd><dt>作成日</dt><dd><%= @plant.created_at.strftime("%Y/%m/%d %H:%M") %></dd><dt>更新日</dt><dd><%= @plant.updated_at.strftime("%Y/%m/%d %H:%M") %></dd></dl>
  <%= image_tag(@plant.thumb_path, class: "record-image", alt: @plant.name) if @plant.has_image? %>
</section>
<section class="panel"><h2>この植物の株</h2><% if @plant.stocks.any? %><% @plant.stocks.each do |stock| %><%= render "/admin/stocks/stock_attr", stock: stock %><% end %><% else %><p class="empty-state">株はまだありません。</p><% end %></section>
<%= form_with model: [:admin, @plant], method: :delete, class: "inline-form" do |f| %><%= f.submit "削除", class: "button-danger", data: { turbo_confirm: "本当に削除しますか？" } %><% end %>
