<div class="page-header">
  <div>
    <h1 class="page-title">株を直接登録</h1>
    <p class="page-subtitle">購入・譲受など、生産ロットを経由しない個体を登録します。</p>
  </div>
  <%= render "actions", stock: @stock, current_action: :new, previous_record: nil, next_record: nil %>
</div>

<%= form_with model: [:admin, @stock], class: "form-card" do |f| %>
  <div class="form-field">
    <%= f.label :plant_id, "植物" %>
    <%= f.select :plant_id, @plant_options, { prompt: "選択してください" }, required: true %>
  </div>
  <div class="form-field">
    <%= f.label :location_id, "場所" %>
    <%= f.select :location_id, @location_options, { prompt: "選択してください" }, required: true %>
  </div>
  <div class="form-field">
    <%= f.label :stage, "現在工程" %>
    <%= f.select :stage, @stage_options, { prompt: "選択してください" }, required: true %>
  </div>
  <div class="form-field">
    <%= f.label :stage_started_on, "現工程の開始日" %>
    <%= f.date_field :stage_started_on, required: true %>
  </div>
  <div class="form-field">
    <%= f.label :potted_on, "鉢上げ日" %>
    <%= f.date_field :potted_on %>
    <p class="form-hint">不明な場合は空欄にできます。</p>
  </div>
  <div class="form-field">
    <%= f.label :memo, "メモ" %>
    <%= f.text_area :memo %>
  </div>
  <%= f.submit "登録" %>
<% end %>
