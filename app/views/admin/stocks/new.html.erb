<div class="page-header"><div><h1 class="page-title">株を作成</h1><p class="page-subtitle">同じ条件で管理する株をひとつの単位として登録します。</p></div></div>
<%= form_with model: [:admin, @stock], class: "form-card" do |f| %>
  <div class="form-field"><%= f.label :location_id, "場所" %><%= f.select :location_id, @location_data, prompt: "選択してください" %></div>
  <div class="form-field"><%= f.label :plant_id, "植物" %><%= f.select :plant_id, @plant_data, prompt: "選択してください" %></div>
  <div class="form-field"><%= f.label :growing_method, "栽培方法" %><%= f.select :growing_method, @growing_method_data, prompt: "選択してください" %></div>
  <div class="form-field"><%= f.label :propagation_method, "増殖方法" %><%= f.select :propagation_method, @propagation_method_data, include_blank: "未設定" %></div>
  <div class="form-field"><%= f.label :quantity, "数量" %><%= f.number_field :quantity, min: 1, value: @stock.quantity || 1 %></div>
  <div class="form-field"><%= f.label :label, "ラベル" %><%= f.text_field :label %></div>
  <div class="form-field"><%= f.label :memo, "メモ" %><%= f.text_area :memo %></div>
  <div class="form-field" data-controller="image-preview"><%= f.label :image, "画像" %><%= f.file_field :image, data: { action: "change->image-preview#preview" } %><img data-image-preview-target="image" width="100" hidden></div>
  <%= f.submit "作成" %>
<% end %>
