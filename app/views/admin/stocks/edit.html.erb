<div class="page-header">
  <div>
    <h1 class="page-title">株を編集</h1>
    <p class="page-subtitle">ST-<%= @stock.id %></p>
  </div>
  <%= render "actions",
             stock: @stock,
             current_action: :edit,
             previous_record: @previous_record,
             next_record: @next_record %>
</div>

<%= form_with model: [:admin, @stock], class: "form-card" do |f| %>
  <div class="form-field">
    <%= f.label :location_id, "場所" %>
    <%= f.select :location_id, @location_options, { prompt: "選択してください" }, required: true %>
  </div>
  <div class="form-field">
    <%= f.label :potted_on, "鉢上げ日" %>
    <%= f.date_field :potted_on %>
  </div>
  <div class="form-field">
    <%= f.label :memo, "現在のメモ" %>
    <%= f.text_area :memo %>
  </div>
  <%= f.submit "更新" %>
<% end %>
