<% if logs.any? %>
  <ul class="log-list">
    <% logs.each do |log| %>
      <li>
        <span class="log-date"><%= log[:recorded_at] || "日時未設定" %></span>
        <span><strong><%= log[:label] %></strong> <%= log[:data_value] %></span>
        <span><%= expandable_thumbnail(log[:image_thumbnail_path], log[:image_path], alt: "観察画像") if log[:image_thumbnail_path].present? %> <%= log[:memo].presence || "—" %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty-state">記録はまだありません。</p>
<% end %>
