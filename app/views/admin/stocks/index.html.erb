<div class="page-header"><div><h1 class="page-title">株</h1><p class="page-subtitle">現在育成中の管理単位を一覧で確認できます。</p></div><%= render "actions", stock: nil, current_action: :index, previous_record: nil, next_record: nil %></div>

<%= form_with url: admin_stocks_path, method: :get, class: "panel filter-form", data: { turbo: false } do |f| %>
  <div class="filter-field">
    <%= f.label :environment, "環境" %>
    <%= f.select :environment, @environment_filter_options, { include_blank: "すべて", selected: @stock_filters[:environment] } %>
  </div>
  <div class="filter-field">
    <%= f.label :location_id, "ロケーション" %>
    <%= f.select :location_id, @location_filter_options, { include_blank: "すべて", selected: @stock_filters[:location_id] } %>
  </div>
  <div class="filter-field">
    <%= f.label :plant_id, "植物" %>
    <%= f.select :plant_id, @plant_filter_options, { include_blank: "すべて", selected: @stock_filters[:plant_id] } %>
  </div>
  <div class="filter-field">
    <%= f.label :status, "状態" %>
    <%= f.select :status, @status_filter_options, { include_blank: "すべて", selected: @stock_filters[:status] } %>
  </div>
  <div class="filter-actions">
    <%= f.submit "絞り込む" %>
    <%= link_to "クリア", admin_stocks_path, class: "button button-secondary" %>
  </div>
<% end %>

<section class="panel table-wrap">
  <% if @stocks.any? %>
    <table>
      <thead>
        <tr>
          <th>画像</th>
          <th>ラベル</th>
          <th>コード</th>
          <th>植物</th>
          <th>場所</th>
          <th>状態</th>
          <th>栽培方法</th>
          <th>数量</th>
          <th>親株候補</th>
          <th>メモ</th>
          <th>登録日</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @stocks.each do |stock| %>
          <tr>
            <td><%= expandable_thumbnail(stock.icon_path, stock.image, alt: stock.code) if stock.has_image? %></td>
            <td><strong><%= stock.label %></strong></td>
            <td><%= stock.code %></td>
            <td><%= stock.plant.name %></td>
            <td><%= stock.location.name %></td>
            <td><span class="status status--<%= stock.status %>"><%= stock.status_i18n %></span></td>
            <td><%= stock.growing_method_i18n %></td>
            <td><%= stock.quantity %> 株</td>
            <td><%= stock.parent_stock_candidate? ? "はい" : "—" %></td>
            <td><%= stock.memo.presence || "—" %></td>
            <td><%= stock.created_at.strftime("%Y/%m/%d") %></td>
            <td>
              <div class="table-actions">
                <%= link_to "詳細", admin_stock_path(stock) %>
                <%= link_to "編集", edit_admin_stock_path(stock) %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">育成中の株はありません。</p>
  <% end %>
</section>
