<div class="page-header">
  <div>
    <h1 class="page-title">株</h1>
    <p class="page-subtitle">鉢上げ後または直接登録した個体を確認します。</p>
  </div>
  <%= render "actions", stock: nil, current_action: :index, previous_record: nil, next_record: nil %>
</div>

<%= form_with url: admin_stocks_path, method: :get, class: "panel filter-form", data: { turbo: false } do |f| %>
  <div class="filter-field">
    <%= f.label :environment, "環境" %>
    <%= f.select :environment,
                 @environment_filter_options,
                 { include_blank: "すべて", selected: @stock_filters[:environment] } %>
  </div>
  <div class="filter-field">
    <%= f.label :location_id, "場所" %>
    <%= f.select :location_id,
                 @location_filter_options,
                 { include_blank: "すべて", selected: @stock_filters[:location_id] } %>
  </div>
  <div class="filter-field">
    <%= f.label :plant_id, "植物" %>
    <%= f.select :plant_id,
                 @plant_filter_options,
                 { include_blank: "すべて", selected: @stock_filters[:plant_id] } %>
  </div>
  <div class="filter-field">
    <%= f.label :stage, "工程" %>
    <%= f.select :stage,
                 @stage_filter_options,
                 { include_blank: "すべて", selected: @stock_filters[:stage] } %>
  </div>
  <div class="filter-field">
    <%= f.label :sale_ready, "販売可能" %>
    <%= f.select :sale_ready,
                 [["販売可能", "ready"], ["販売可能前", "not_ready"]],
                 { include_blank: "すべて", selected: @stock_filters[:sale_ready] } %>
  </div>
  <div class="filter-field">
    <%= f.label :completion, "管理状態" %>
    <%= f.select :completion,
                 [["管理中", "active"], ["完了", "completed"]],
                 { include_blank: "すべて", selected: @stock_filters[:completion] } %>
  </div>
  <div class="filter-actions">
    <%= f.submit "絞り込む" %>
    <%= link_to "クリア", admin_stocks_path, class: "button button-secondary" %>
    <%# 絞り込んだ株のQRラベルをA4へまとめて出す %>
    <%= link_to "QRラベルを印刷",
                labels_admin_stocks_path(@stock_filters),
                class: "button button-secondary" %>
  </div>
<% end %>

<section class="panel table-wrap">
  <% if @stocks.any? %>
    <table>
      <thead>
        <tr>
          <th>株</th>
          <th>植物</th>
          <th>場所</th>
          <th>工程</th>
          <th>販売可能</th>
          <th>管理状態</th>
          <th>出自</th>
          <th>メモ</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @stocks.each do |stock| %>
          <tr>
            <td><strong><%= link_to "ST-#{stock.id}", admin_stock_path(stock) %></strong></td>
            <td><%= stock.plant.name %></td>
            <td><%= stock.location.name %></td>
            <td><span class="status status--<%= stock.stage %>"><%= stock.stage_i18n %></span></td>
            <td><%= stock.sale_ready? ? stock.sale_ready_on.strftime("%Y/%m/%d") : "—" %></td>
            <td><%= stock.completed_at ? "完了" : "管理中" %></td>
            <td>
              <% if stock.production_lot %>
                <%= link_to "LOT-#{stock.production_lot.id}", admin_production_lot_path(stock.production_lot) %>
              <% else %>
                直接登録
              <% end %>
            </td>
            <td><%= stock.memo.presence || "—" %></td>
            <td>
              <div class="table-actions">
                <%= link_to "詳細", admin_stock_path(stock) %>
                <%= link_to "編集", edit_admin_stock_path(stock) %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">該当する株はありません。</p>
  <% end %>
</section>
