<div class="stock-card-header">
  <div>
    <h3 class="stock-card-title">ST-<%= stock.id %></h3>
    <span class="status status--<%= stock.stage %>"><%= stock.stage_i18n %></span>
    <% if stock.completed_at %>
      <span class="tag">管理完了</span>
    <% elsif stock.sale_ready? %>
      <span class="tag">販売可能</span>
    <% end %>
  </div>
</div>
<dl class="detail-list">
  <dt>植物</dt>
  <dd><%= stock.plant.name %></dd>
  <dt>場所</dt>
  <dd><%= stock.location.name %></dd>
  <dt>現工程開始日</dt>
  <dd><%= stock.stage_started_on.strftime("%Y/%m/%d") %></dd>
  <dt>鉢上げ日</dt>
  <dd><%= stock.potted_on&.strftime("%Y/%m/%d") || "—" %></dd>
  <dt>販売可能日</dt>
  <dd><%= stock.sale_ready_on&.strftime("%Y/%m/%d") || "—" %></dd>
  <dt>出自</dt>
  <dd>
    <% if stock.production_lot %>
      <%= link_to "LOT-#{stock.production_lot.id}", admin_production_lot_path(stock.production_lot) %>
    <% else %>
      直接登録
    <% end %>
  </dd>
  <dt>鉢上げ元</dt>
  <dd>
    <% if stock.source_nursery_group %>
      <%= link_to "NG-#{stock.source_nursery_group.id}", admin_nursery_group_path(stock.source_nursery_group) %>
    <% else %>
      —
    <% end %>
  </dd>
  <dt>商品形態</dt>
  <dd><%= stock.product_type_i18n || "—" %></dd>
  <dt>公開ページ</dt>
  <dd>
    <% if stock.published_at %>
      <%= link_to "/p/#{stock.public_token}", public_stock_path(stock.public_token) %>
      （<%= stock.published_at.strftime("%Y/%m/%d %H:%M") %> 公開）
    <% else %>
      非公開
    <% end %>
  </dd>
  <dt>管理完了日時</dt>
  <dd><%= stock.completed_at&.strftime("%Y/%m/%d %H:%M") || "—" %></dd>
  <dt>完了理由</dt>
  <dd><%= stock.completion_reason_i18n || "—" %></dd>
  <dt>メモ</dt>
  <dd><%= stock.memo.presence || "—" %></dd>
</dl>
