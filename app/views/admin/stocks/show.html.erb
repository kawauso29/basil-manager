<div class="page-header"><div><h1 class="page-title"><%= @stock.display_name %></h1><p class="page-subtitle"><%= @stock.plant.name %> / <%= @stock.location.name %></p></div><%= render "actions", stock: @stock, current_action: :show, previous_record: @previous_record, next_record: @next_record %></div>
<%= render "/admin/stocks/stock_detail", stock: @stock %>

<section class="panel"><h2>履歴</h2><%= render "/admin/stocks/logs", logs: @stock_logs %></section>

<section class="panel"><h2>系譜</h2><dl class="detail-list"><dt>親株</dt><dd><% if @stock.has_parent? %><%= link_to @stock.parent_stock.display_name, admin_stock_path(@stock.parent_stock) %><% else %>なし<% end %></dd><dt>子株</dt><dd><%= @stock.child_stocks.count %> 件</dd></dl><% @stock.child_stocks.each do |child_stock| %><%= render "/admin/stocks/stock_attr", stock: child_stock %><% end %></section>
