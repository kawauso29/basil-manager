<div class="page-header">
  <div>
    <h1 class="page-title"><%= @stock.display_name %></h1>
    <p class="page-subtitle"><%= @stock.plant.name %> / <%= @stock.location.name %></p>
  </div>
  <%= render "actions",
             stock: @stock,
             current_action: :show,
             previous_record: @previous_record,
             next_record: @next_record %>
</div>

<%= render "/admin/stocks/stock_detail", stock: @stock %>

<section class="panel">
  <h2>履歴</h2>
  <%= render "/admin/stocks/logs", logs: @stock_logs %>
</section>
