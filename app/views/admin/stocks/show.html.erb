<div class="page-header"><div><h1 class="page-title"><%= @stock.display_name %></h1><p class="page-subtitle"><%= @stock.plant.name %> / <%= @stock.location.name %></p></div><div class="page-actions"><%= link_to "編集", edit_admin_stock_path(@stock), class: "button" %><%= link_to "数量を変更", edit_quantity_admin_stock_path(@stock), class: "button button-secondary" %><%= link_to "一覧へ戻る", admin_stocks_path, class: "button button-secondary" %></div></div>
<%= render "/admin/stocks/stock_attr", stock: @stock %>

<section class="panel"><h2>記録を追加</h2><div class="page-actions"><%= link_to "作業を記録", new_admin_stock_action_log_path(stock_id: @stock.id), class: "button button-secondary" %><%= link_to "観察を記録", new_admin_stock_observation_path(stock_id: @stock.id), class: "button button-secondary" %></div></section>

<section class="panel"><h2>履歴</h2><%= render "/admin/stocks/logs", logs: @stock_logs %></section>

<section class="panel"><h2>系譜</h2><dl class="detail-list"><dt>親株</dt><dd><% if @stock.has_parent? %><%= link_to @stock.parent_stock.display_name, admin_stock_path(@stock.parent_stock) %><% else %>なし<% end %></dd><dt>子株</dt><dd><%= @stock.child_stocks.count %> 件</dd></dl><% @stock.child_stocks.each do |child_stock| %><%= render "/admin/stocks/stock_attr", stock: child_stock %><% end %></section>

<%= form_with model: [:admin, @stock], method: :delete, class: "inline-form" do |f| %><%= f.submit "削除", class: "button-danger", data: { turbo_confirm: "本当に削除しますか？" } %><% end %>
