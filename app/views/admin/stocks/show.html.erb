<div class="page-header">
  <div>
    <h1 class="page-title">ST-<%= @stock.id %></h1>
    <p class="page-subtitle"><%= @stock.plant.name %> / <%= @stock.location.name %></p>
  </div>
  <%= render "actions",
             stock: @stock,
             current_action: :show,
             previous_record: @previous_record,
             next_record: @next_record %>
</div>

<%= render "/admin/stocks/stock_detail", stock: @stock %>

<section class="panel">
  <h2>鉢に貼るQRコード</h2>
  <p>
    読み取ると公開ページ
    <%= link_to @stock.public_url, public_stock_path(@stock.public_token) %>
    が開きます。画像を右クリックして保存し、2cm以上の大きさで印刷してください。
  </p>
  <%= image_tag qr_admin_stock_path(@stock),
                alt: "#{@stock.display_name}の公開ページQRコード",
                width: 200,
                height: 200 %>
</section>

<section class="panel">
  <h2>最新の草丈</h2>
  <% if @latest_height_observation %>
    <p>
      <strong><%= @latest_height_observation.height_cm %> cm</strong>
      （<%= @latest_height_observation.recorded_at.strftime("%Y/%m/%d %H:%M") %>）
    </p>
  <% else %>
    <p class="empty-state">草丈はまだ記録されていません。</p>
  <% end %>
</section>

<section class="panel">
  <h2>観察記録</h2>
  <% if @stock_observations.any? %>
    <ul class="log-list">
      <% @stock_observations.each do |observation| %>
        <li>
          <span class="log-date"><%= observation.recorded_at.strftime("%Y/%m/%d %H:%M") %></span>
          <span>
            <strong><%= observation.height_cm ? "#{observation.height_cm} cm" : "観察" %></strong>
          </span>
          <span>
            <%= expandable_thumbnail(observation.image_small_path, observation.image, alt: "観察画像") if observation.has_image? %>
            <%= observation.memo.presence || "—" %>
            <%= link_to "詳細", admin_stock_observation_path(observation) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">観察記録はまだありません。</p>
  <% end %>
</section>
