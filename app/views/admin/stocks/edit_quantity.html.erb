<div class="page-header"><div><h1 class="page-title">数量を変更</h1><p class="page-subtitle"><%= @stock.display_name %></p></div><div class="page-actions"><%= link_to "株詳細へ戻る", admin_stock_path(@stock), class: "button button-secondary" %></div></div>
<section class="form-card"><%= form_with url: change_quantity_admin_stock_path(@stock), method: :patch, scope: :stock_quantity do |f| %><div class="form-field"><%= f.label :quantity, "数量" %><%= f.number_field :quantity, value: @stock.quantity, min: 1 %></div><div class="form-field"><%= f.label :memo, "変更理由" %><%= f.text_area :memo %></div><%= f.submit "数量を変更" %><% end %></section>
