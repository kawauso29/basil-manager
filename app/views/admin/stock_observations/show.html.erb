<div class="page-header"><div><h1 class="page-title">観察記録</h1><p class="page-subtitle"><%= @stock.code %> / <%= @plant.name %></p></div><div class="page-actions"><%= link_to "編集", edit_admin_stock_observation_path(@stock_observation), class: "button" %><%= link_to "一覧へ戻る", admin_stock_observations_path, class: "button button-secondary" %></div></div>
<section class="detail-card detail-layout"><dl class="detail-list"><dt>場所</dt><dd><%= @location.name %></dd><dt>高さ</dt><dd><%= @stock_observation.height_cm %> cm</dd><dt>観察日時</dt><dd><%= @stock_observation.recorded_at&.strftime("%Y/%m/%d %H:%M") || "未設定" %></dd><dt>メモ</dt><dd><%= @stock_observation.memo.presence || "—" %></dd></dl><%= image_tag(@stock_observation.image_normal_path, class: "record-image", alt: "観察画像") if @stock_observation.has_image? %></section>
<%= form_with model: [:admin, @stock_observation], method: :delete, class: "inline-form" do |f| %><%= f.submit "削除", class: "button-danger", data: { turbo_confirm: "本当に削除しますか？" } %><% end %>
