id: <%= @stock_observation.id %><br>
stock_code: <%= @stock.code %><br>
location_name: <%= @location.name %>
plant_name: <%= @plant.name %><br>
<%= form_with model: [:admin, @stock_observation] do |f| %>
  height_cm:  <%= f.number_field(:height_cm) %><br>
  memo: <%= f.text_area :memo %><br>
  recorded_at: <%= f.datetime_local_field :recorded_at %><br>
  <h2>画像アップロード</h2><br>
  <% if @stock_observation.has_image? %>
    現在の画像：<%= image_tag(@location.icon_path) %><br><br>
  <% end %>
  <div data-controller="image-preview">
    <%= f.file_field :image, data: { action: "change->image-preview#preview" } %><img data-image-preview-target="image" width="100" hidden><br>
  </div>
  <%= f.submit "更新" %>
<% end %>