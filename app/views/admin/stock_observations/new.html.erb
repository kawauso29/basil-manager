<div class="page-header">
  <div>
    <h1 class="page-title">観察を記録</h1>
    <p class="page-subtitle">草丈・メモ・画像のいずれかを入力してください。</p>
  </div>
</div>

<%= form_with model: [:admin, @stock_observation], class: "form-card" do |f| %>
  <div class="form-field">
    <%= f.label :stock_id, "株" %>
    <%= f.select :stock_id, @stock_data, { prompt: "選択してください" }, required: true %>
  </div>
  <div class="form-field">
    <%= f.label :height_cm, "草丈（cm）" %>
    <%= f.number_field :height_cm, step: 0.1, min: 0 %>
  </div>
  <div class="form-field">
    <%= f.label :memo, "メモ" %>
    <%= f.text_area :memo %>
  </div>
  <div class="form-field">
    <%= f.label :recorded_at, "観察日時" %>
    <%= f.datetime_local_field :recorded_at, required: true %>
  </div>
  <div class="form-field" data-controller="image-preview">
    <%= f.label :image, "画像" %>
    <%= f.file_field :image, data: { action: "change->image-preview#preview" } %>
    <img data-image-preview-target="image" width="100" hidden>
  </div>
  <%= f.submit "記録" %>
<% end %>
