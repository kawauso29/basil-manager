<div class="page-header"><div><h1 class="page-title">場所を編集</h1><p class="page-subtitle"><%= @location.name %>（ID: <%= @location.id %>）</p></div><%= render "actions", location: @location, current_action: :edit, previous_record: @previous_record, next_record: @next_record %></div>
<%= form_with model: [:admin, @location], class: "form-card" do |f| %>
  <div class="form-field"><%= f.label :name, "名前" %><%= f.text_field :name %></div>
  <div class="form-field"><%= f.label :code, "コード" %><%= f.text_field :code %></div>
  <div class="form-field"><%= f.label :environment, "環境" %><%= f.select :environment, @environment_data, prompt: "選択してください" %></div>
  <div class="form-field" data-controller="image-preview"><%= f.label :image, "画像" %><%= expandable_thumbnail(@location.icon_path, @location.image, alt: "現在の画像") if @location.has_image? %><%= f.file_field :image, data: { action: "change->image-preview#preview" } %><img data-image-preview-target="image" width="100" hidden></div>
  <%= f.submit "更新" %>
<% end %>
