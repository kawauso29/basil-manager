<div class="page-header"><div><h1 class="page-title"><%= @location.name %></h1><p class="page-subtitle">管理場所</p></div><div class="page-actions"><%= render "admin/shared/record_navigation", previous_record: @previous_record, next_record: @next_record, navigation_action: nil %><%= link_to "編集", edit_admin_location_path(@location), class: "button" %><%= link_to "この場所の記録", admin_location_observations_path(location_id: @location.id), class: "button button-secondary" %><%= link_to "一覧へ戻る", admin_locations_path, class: "button button-secondary" %></div></div>
<section class="detail-card detail-layout"><dl class="detail-list"><dt>コード</dt><dd><%= @location.code %></dd><dt>プレフィックス</dt><dd><%= @location.prefix %></dd><dt>環境</dt><dd><span class="tag"><%= @location.environment_i18n %></span></dd><dt>作成日</dt><dd><%= @location.created_at.strftime("%Y/%m/%d %H:%M") %></dd><dt>更新日</dt><dd><%= @location.updated_at.strftime("%Y/%m/%d %H:%M") %></dd></dl><%= image_tag(@location.thumb_path, class: "record-image", alt: @location.name) if @location.has_image? %></section>
<section class="panel"><h2>この場所の株</h2><% if @location.stocks.any? %><% @location.stocks.each do |stock| %><%= render "/admin/stocks/stock_attr", stock: stock %><% end %><% else %><p class="empty-state">現在この場所にある株はありません。</p><% end %></section>
<%= form_with model: [:admin, @location], method: :delete, class: "inline-form" do |f| %><%= f.submit "削除", class: "button-danger", data: { turbo_confirm: "本当に削除しますか？" } %><% end %>
