<div class="page-header">
  <div>
    <h1 class="page-title"><%= @location.name %></h1>
    <p class="page-subtitle">管理場所</p>
  </div>
  <%= render "actions",
             location: @location,
             current_action: :show,
             previous_record: @previous_record,
             next_record: @next_record %>
</div>

<section class="detail-card detail-layout">
  <dl class="detail-list">
    <dt>コード</dt>
    <dd><%= @location.code %></dd>
    <dt>環境</dt>
    <dd><span class="tag"><%= @location.environment_i18n %></span></dd>
    <dt>作成日</dt>
    <dd><%= @location.created_at.strftime("%Y/%m/%d %H:%M") %></dd>
    <dt>更新日</dt>
    <dd><%= @location.updated_at.strftime("%Y/%m/%d %H:%M") %></dd>
  </dl>
  <%= image_tag(@location.thumb_path, class: "record-image", alt: @location.name) if @location.has_image? %>
</section>

<section class="panel">
  <h2>この場所の苗グループ</h2>
  <% if @nursery_groups.any? %>
    <div class="page-actions">
      <% @nursery_groups.each do |nursery_group| %>
        <%= link_to "NG-#{nursery_group.id}", admin_nursery_group_path(nursery_group), class: "button button-secondary" %>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state">現在この場所にある苗グループはありません。</p>
  <% end %>
</section>

<section class="panel">
  <h2>この場所の株</h2>
  <% if @stocks.any? %>
    <% @stocks.each do |stock| %>
      <%= render "/admin/stocks/stock_attr", stock: stock %>
    <% end %>
  <% else %>
    <p class="empty-state">現在この場所にある株はありません。</p>
  <% end %>
</section>
