<div class="page-header"><div><h1 class="page-title">作業履歴</h1><p class="page-subtitle">直近30件の株への作業・変更履歴です。</p></div><div class="page-actions"><%= link_to "作業を記録", new_admin_stock_action_log_path, class: "button" %><%= link_to "水やりを一括記録", bulk_new_admin_stock_action_logs_path, class: "button button-secondary" %></div></div>
<section class="panel table-wrap">
<% if @stock_action_logs.any? %>
<table>
<thead>
  <tr>
    <th>日時</th>
    <th>株</th>
    <th>植物 / 場所</th>
    <th>内容</th>
    <th>メモ</th>
    <th></th>
  </tr>
</thead>
<tbody>
<% @stock_action_logs.each do |log| %>
  <tr>
    <td><%= log.recorded_at&.strftime("%Y/%m/%d %H:%M") || "未設定" %></td>
    <td><%= log.stock.display_name %></td>
    <td><%= log.stock.plant.name %> / <%= log.stock.location.name %></td>
    <td><%= log.action_type_i18n %></td>
    <td><%= log.memo %></td>
    <td><%= link_to "詳細", admin_stock_action_log_path(log) %></td>
  </tr>
<% end %>
</tbody>
</table>
<% else %>
    <p class="empty-state">作業履歴はまだありません。</p>
<% end %>
</section>
