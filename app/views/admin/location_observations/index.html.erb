<div class="page-header"><div><h1 class="page-title">場所の記録</h1><p class="page-subtitle">気温や天候など、場所ごとの環境を記録します。</p></div><div class="page-actions"><%= link_to "記録を追加", new_admin_location_observation_path, class: "button" %><%= link_to "一括作成", bulk_new_admin_location_observations_path, class: "button button-secondary" %></div></div>
<section class="panel"><%= form_with url: admin_location_observations_path, method: :get do %><div class="form-field"><%= label_tag :location_id, "場所で絞り込む" %><%= select_tag :location_id, options_for_select(@location_options, @location&.id) %></div><%= submit_tag "絞り込む" %><% end %></section>
<section class="panel table-wrap"><% if @location_observations.any? %><table><thead><tr><th>日時</th><th>場所</th><th>気温</th><th>天候</th><th>メモ</th><th></th></tr></thead><tbody><% @location_observations.each do |observation| %><tr><td><%= observation.recorded_at&.strftime("%Y/%m/%d %H:%M") || "未設定" %></td><td><%= observation.location.name %></td><td><%= observation.temperature %> ℃</td><td><%= observation.weather_i18n %></td><td><%= observation.memo %></td><td><%= link_to "編集", edit_admin_location_observation_path(observation) %></td></tr><% end %></tbody></table><% else %><p class="empty-state">記録はまだありません。</p><% end %></section>
