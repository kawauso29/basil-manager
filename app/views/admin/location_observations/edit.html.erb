<div class="page-header"><div><h1 class="page-title">場所の記録を編集</h1><p class="page-subtitle">ID: <%= @location_observation.id %></p></div><div class="page-actions"><%= link_to "一覧へ戻る", admin_location_observations_path, class: "button button-secondary" %></div></div>
<%= form_with model: [:admin, @location_observation], class: "form-card" do |f| %>
  <div class="form-field"><%= f.label :location_id, "場所" %><%= f.select :location_id, @location_data, prompt: "選択してください" %></div>
  <div class="form-field"><%= f.label :weather, "天候" %><%= f.select :weather, @weather_data, prompt: "選択してください" %></div>
  <div class="form-field"><%= f.label :temperature, "気温（℃）" %><%= f.number_field :temperature, step: 0.1 %></div>
  <div class="form-field"><%= f.label :memo, "メモ" %><%= f.text_area :memo %></div>
  <div class="form-field"><%= f.label :recorded_at, "記録日時" %><%= f.datetime_local_field :recorded_at %></div>
  <%= f.submit "更新" %>
<% end %>
<%= form_with model: [:admin, @location_observation], method: :delete, class: "inline-form" do |f| %><%= f.submit "削除", class: "button-danger", data: { turbo_confirm: "本当に削除しますか？" } %><% end %>
